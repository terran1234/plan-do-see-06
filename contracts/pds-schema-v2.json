{
  "schema": "pds-schema-v2",
  "title": "플랜두씨 다이어리 최종 데이터베이스 계약",
  "database": "PostgreSQL (Supabase, public 스키마)",
  "source_of_truth": "supabase/schema.sql",
  "conventions": {
    "ids": "모든 표의 id 는 uuid (gen_random_uuid()). 한 번 만들면 바뀌지 않는다.",
    "timestamps": {
      "type": "timestamptz",
      "stored_as": "UTC",
      "displayed_as": "Asia/Seoul (UTC+9, 서머타임 없음)",
      "export_format": "ISO 8601 UTC. 표의 시각 컬럼은 DB가 주는 그대로(예: 2026-10-07T00:00:00+00:00 = 서울 09:00), exported_at 은 2026-10-07T05:12:13.000Z 형식",
      "input_rule": "화면의 datetime-local 입력은 서울 시간으로 보고 +09:00 을 붙여 저장한다."
    },
    "dates": {
      "type": "date",
      "meaning": "서울 달력 날짜. 시간대 변환 없이 YYYY-MM-DD 그대로 저장·표시·내보낸다.",
      "today": "'오늘'은 서울 시간 기준 날짜다. 지연 판단: 완료가 아니고 due_date < 오늘(서울)."
    },
    "units": {
      "estimated_hours": "시간(hour), numeric(6,1) — 0.5 단위로 입력",
      "actual_minutes": "분(minute), integer",
      "calculation": "시간 비교·합계는 모두 분으로 맞춘다(예상 시간 × 60). 차이 = 실제 − 예상."
    },
    "enums": {
      "priority": ["높음", "보통", "낮음"],
      "todo_status": ["진행 중", "완료"]
    }
  },
  "tables": {
    "plans": {
      "meaning": "계획 (현재 값). 고쳐도 id 는 그대로, 내용만 바뀐다.",
      "primary_key": ["id"],
      "columns": {
        "id": { "type": "uuid", "nullable": false, "default": "gen_random_uuid()" },
        "user_id": { "type": "uuid", "nullable": false, "references": "auth.users.id", "on_delete": "cascade", "meaning": "이 계획의 주인(로그인한 사용자)" },
        "title": { "type": "text", "nullable": false },
        "start_date": { "type": "date", "nullable": false },
        "end_date": { "type": "date", "nullable": false },
        "priority": { "type": "text", "nullable": false, "check": "in ('높음','보통','낮음')" },
        "success_criteria": { "type": "text", "nullable": false },
        "estimated_hours": { "type": "numeric(6,1)", "nullable": false, "unit": "hour", "check": "> 0" },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "updated_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "checks": ["end_date >= start_date"],
      "triggers": [
        "after insert: 처음 계획을 plan_revisions 에 v1 으로 남긴다",
        "after update (값이 바뀐 경우만): 바뀐 내용을 plan_revisions 에 다음 버전으로 남긴다",
        "before update: updated_at 갱신"
      ]
    },
    "plan_revisions": {
      "meaning": "계획의 모든 버전(처음 세운 것 포함). 한 번 쓰면 고칠 수 없다.",
      "primary_key": ["id"],
      "columns": {
        "id": { "type": "uuid", "nullable": false, "default": "gen_random_uuid()" },
        "plan_id": { "type": "uuid", "nullable": false, "references": "plans.id", "on_delete": "cascade" },
        "revision_no": { "type": "integer", "nullable": false, "note": "1 = 처음 계획" },
        "title": { "type": "text", "nullable": false },
        "start_date": { "type": "date", "nullable": false },
        "end_date": { "type": "date", "nullable": false },
        "priority": { "type": "text", "nullable": false },
        "success_criteria": { "type": "text", "nullable": false },
        "estimated_hours": { "type": "numeric(6,1)", "nullable": false, "unit": "hour" },
        "revised_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "unique": [["plan_id", "revision_no"]],
      "triggers": ["before update: 항상 거부 (이력은 고쳐 쓸 수 없다)"]
    },
    "todos": {
      "meaning": "계획에 딸린 할 일 (계획 쪽 값). 실행 기록은 별도 표에 둬서 이 값을 덮어쓰지 않는다.",
      "primary_key": ["id"],
      "columns": {
        "id": { "type": "uuid", "nullable": false, "default": "gen_random_uuid()" },
        "plan_id": { "type": "uuid", "nullable": false, "references": "plans.id", "on_delete": "cascade" },
        "title": { "type": "text", "nullable": false },
        "due_date": { "type": "date", "nullable": false },
        "priority": { "type": "text", "nullable": false, "check": "in ('높음','보통','낮음')" },
        "tags": { "type": "text[]", "nullable": false, "default": "{}", "note": "최대 5개, 각 20자 이하(앱에서 검사)" },
        "estimated_hours": { "type": "numeric(6,1)", "nullable": false, "unit": "hour", "check": "> 0" },
        "status": { "type": "text", "nullable": false, "default": "진행 중", "check": "in ('진행 중','완료')" },
        "completed_at": { "type": "timestamptz", "nullable": true },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "updated_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "source_review_id": { "type": "uuid", "nullable": true, "references": "reviews.id", "on_delete": "set null", "note": "돌아보기에서 넘어온 할 일이면 그 돌아보기" }
      },
      "indexes": [
        { "name": "todos_plan_id_idx", "columns": ["plan_id"] },
        { "name": "todos_one_per_review", "columns": ["source_review_id"], "unique": true, "where": "source_review_id is not null" }
      ]
    },
    "execution_logs": {
      "meaning": "실제로 한 일 기록. 할 일에 이어지고, 계획 값은 건드리지 않는다.",
      "primary_key": ["id"],
      "columns": {
        "id": { "type": "uuid", "nullable": false, "default": "gen_random_uuid()" },
        "todo_id": { "type": "uuid", "nullable": false, "references": "todos.id", "on_delete": "cascade" },
        "started_at": { "type": "timestamptz", "nullable": false },
        "ended_at": { "type": "timestamptz", "nullable": false },
        "actual_minutes": { "type": "integer", "nullable": false, "unit": "minute", "check": "> 0" },
        "blocked_reason": { "type": "text", "nullable": true, "note": "막히지 않았으면 null" },
        "request_key": { "type": "text", "nullable": false, "unique": true, "note": "같은 요청이 두 번 와도 한 건만 저장" },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "checks": [
        "ended_at >= started_at",
        "actual_minutes <= ceil((ended_at - started_at) in minutes)"
      ],
      "indexes": [{ "name": "execution_logs_todo_id_idx", "columns": ["todo_id"] }]
    },
    "completions": {
      "meaning": "완료 기록. 완료할 때마다 한 줄, 되돌리면 reverted_at 만 채운다.",
      "primary_key": ["id"],
      "columns": {
        "id": { "type": "uuid", "nullable": false, "default": "gen_random_uuid()" },
        "todo_id": { "type": "uuid", "nullable": false, "references": "todos.id", "on_delete": "cascade" },
        "completed_at": { "type": "timestamptz", "nullable": false, "default": "now()" },
        "reverted_at": { "type": "timestamptz", "nullable": true },
        "request_key": { "type": "text", "nullable": false, "unique": true }
      },
      "indexes": [
        { "name": "completions_one_open", "columns": ["todo_id"], "unique": true, "where": "reverted_at is null", "note": "한 할 일에 열린 완료 기록은 하나뿐" }
      ]
    },
    "reviews": {
      "meaning": "돌아보기에서 정한 고칠 점 한 줄과 그 시점의 집계 숫자.",
      "primary_key": ["id"],
      "columns": {
        "id": { "type": "uuid", "nullable": false, "default": "gen_random_uuid()" },
        "plan_id": { "type": "uuid", "nullable": false, "references": "plans.id", "on_delete": "cascade" },
        "period_from": { "type": "date", "nullable": false },
        "period_to": { "type": "date", "nullable": false },
        "takeaway": { "type": "text", "nullable": false, "check": "char_length between 1 and 100" },
        "snapshot": {
          "type": "jsonb",
          "nullable": false,
          "shape": {
            "planned": "개수", "done": "개수", "late": "개수", "blocked": "개수",
            "estMinutes": "분", "actualMinutes": "분", "diffMinutes": "분 (실제 − 예상)",
            "today": "YYYY-MM-DD (서울 기준, 그 집계를 낸 날)"
          }
        },
        "created_at": { "type": "timestamptz", "nullable": false, "default": "now()" }
      },
      "checks": ["period_to >= period_from"],
      "unique": [["plan_id", "period_from", "period_to"]]
    }
  },
  "relations": [
    { "from": "plan_revisions.plan_id", "to": "plans.id", "cardinality": "many-to-one", "on_delete": "cascade" },
    { "from": "todos.plan_id", "to": "plans.id", "cardinality": "many-to-one", "on_delete": "cascade" },
    { "from": "execution_logs.todo_id", "to": "todos.id", "cardinality": "many-to-one", "on_delete": "cascade" },
    { "from": "completions.todo_id", "to": "todos.id", "cardinality": "many-to-one", "on_delete": "cascade" },
    { "from": "reviews.plan_id", "to": "plans.id", "cardinality": "many-to-one", "on_delete": "cascade" },
    { "from": "todos.source_review_id", "to": "reviews.id", "cardinality": "one-to-one(optional)", "on_delete": "set null" }
  ],
  "functions": {
    "complete_todo(p_todo uuid, p_plan uuid, p_key text) -> boolean": "할 일을 완료로 바꾸고 완료 기록을 남긴다. 같은 키이거나 이미 열린 기록이 있으면 새 기록 없이 false.",
    "reopen_todo(p_todo uuid, p_plan uuid) -> boolean": "열린 완료 기록을 닫고(reverted_at) 진행 중으로 되돌린다.",
    "carry_review(p_plan, p_from, p_to, p_takeaway, p_snapshot, p_due, p_priority, p_hours) -> uuid": "한 트랜잭션으로 돌아보기 기록과 다음 계획 할 일을 만든다. 같은 기간이면 null."
  },
  "definitions": {
    "집계 대상": "마감일이 고른 기간 안에 있는 할 일 (지운 할 일은 행이 없으므로 자동 제외)",
    "계획 수": "집계 대상 수",
    "완료 수": "집계 대상 중 status = '완료'",
    "지연 수": "집계 대상 중 status <> '완료' 이고 due_date < 오늘(서울). 완료한 할 일은 지연으로 세지 않는다.",
    "막힘 수": "blocked_reason 이 비어 있지 않은 실행 기록이 하나라도 있는 할 일의 수",
    "예상 시간": "집계 대상 estimated_hours 합계 × 60 (분)",
    "실제 시간": "집계 대상 할 일의 execution_logs.actual_minutes 합계 (기록이 없으면 0)",
    "차이": "실제 시간 − 예상 시간 (분). 대상이 없으면 0"
  },
  "access_policy": {
    "browser": "브라우저는 DB 에 직접 접근하지 못한다. anon/authenticated 역할의 권한은 모두 회수했고 모든 표는 RLS 를 켰다.",
    "server": "서버(Next.js)만 service_role 키로 접근하며, 그 키는 서버 환경변수에만 있고 코드·응답·Git 에 없다.",
    "login": "아직 로그인이 없다. 링크를 아는 사람은 누구나 앱을 통해 읽고 쓸 수 있다 (7번 과제에서 잠근다)."
  },
  "export": {
    "endpoint": "/api/export",
    "format": "JSON 파일 하나. { format, schema, exported_at, notes, counts, data: { <표 이름>: [행…] } }",
    "tables": ["plans", "plan_revisions", "todos", "execution_logs", "completions", "reviews"]
  }
}
